# LangGraph Development Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4

# Alternative: Azure OpenAI Configuration
# AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# FHIRSheets Configuration
FHIRSHEETS_WORKING_DIR=./output
FHIRSHEETS_CONFIG_PATH=

# LangGraph Configuration
LANGGRAPH_VERBOSE=true
LANGGRAPH_MAX_ITERATIONS=50